# Copy to .env and fill in. EXPO_PUBLIC_* values are built into the app (never put secrets here).
APP_ENV=development
# Your Django API (on a phone use your computer's Wi-Fi IP, not localhost)

# //EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1
EXPO_PUBLIC_API_URL=https://backend-drf-ygow.onrender.com/api/v1
# From `eas init` (needed for push notifications)
EAS_PROJECT_ID=
# Seconds before an API call gives up (Render free server can take ~60 s to wake up)
EXPO_PUBLIC_API_TIMEOUT=60
